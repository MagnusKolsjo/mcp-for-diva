# ============================================================================
# Databasanslutning
# ============================================================================
# PostgreSQL-backend: eget schema och samtidiga skrivningar
DATABASE_URL=postgresql://<ANVÄNDARE>:<LÖSENORD>@localhost:5432/<DATABASNAMN>

# SQLite-backend: en lokal fil, ingen serverprocess
# DATABASE_URL=sqlite:///diva_cache.db

# ============================================================================
# Transport
# ============================================================================
# stdio: MCP-klienten startar processen (standard för lokal användning)
# http:  Servern lyssnar på MCP_HOST:MCP_PORT (för hostad driftsättning)
MCP_TRANSPORT=stdio

# ----------------------------------------------------------------------------
# HTTP-transport (används bara om MCP_TRANSPORT=http)
# ----------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8015
# Bearer-nyckel, obligatorisk i http-läget — utan den avbryts uppstarten
# (exitkod 2). Påverkar inte stdio-läget.
# Generera nyckel med: python3 -c "import secrets; print(secrets.token_hex(32))"
MCP_API_KEY=

# ============================================================================
# Flerspråkig begreppsexpansion (valfri)
# ============================================================================
# Expanderar söktermer till ekvivalenter på sv/en/fr/de/no/da via AI-endpoint
QUERY_EXPANSION_ENABLED=false
# QUERY_EXPANSION_API_URL=https://api.anthropic.com/v1/messages
# QUERY_EXPANSION_API_KEY=<API-NYCKEL>
# QUERY_EXPANSION_MODEL=claude-haiku-4-5-20251001

# ============================================================================
# Epistemisk status — grundpoäng per publikationstyp (1-5)
# ============================================================================
EPISTEMISK_DOKTORSAVHANDLING=5
EPISTEMISK_LICENTIATAVHANDLING=4
EPISTEMISK_ARTIKEL_GRANSKAD=4
EPISTEMISK_BOK=3
EPISTEMISK_KONFERENSBIDRAG_GRANSKAD=3
EPISTEMISK_RAPPORT=2
EPISTEMISK_EXAMENSARBETE_AVANCERAD=2
EPISTEMISK_EXAMENSARBETE_GRUND=1
EPISTEMISK_OVRIG=1

# ============================================================================
# PDF-cache
# ============================================================================
# PDF_CACHE_DIR=./pdf_cache   (standard: mappen 'pdf_cache' bredvid skriptet)
PDF_CACHE_TTL_DAGAR=7

# ============================================================================
# PDF-extraktion — minnesvakt, OCR-språk och OCR-kö
# Se pdftext_skydd.py. Extraktionen körs i en egen process per sidblock; en
# vakt i föräldraprocessen avbryter blocket om det passerar minnes- eller
# tidsgränsen, och läser då sidorna med ren textutvinning i stället.
# ============================================================================
# Tesseract-språk för sidor utan textlager. DiVA:s avhandlingar och artiklar
# är mest svenska och engelska, med enstaka franska och tyska.
DIVA_OCR_SPRAK=swe+eng+fra+deu
# Minnesgräns per extraktionsprocess i MB
# DIVA_PDF_MAX_MINNE_MB=3000
# Tidsgräns per sidblock i sekunder
# DIVA_PDF_TIDSGRANS_S=300
# Antal sidor per block
# DIVA_PDF_SIDBLOCK=20
# Mapp för OCR-kön (dokument där ett block föll tillbaka på ren textutvinning)
# DIVA_OCR_KO_MAPP=ocr_ko

# ============================================================================
# Lärosätesfiltrering — utöka vid behov (kommaseparerade DiVA-ID:n)
# ============================================================================
# DIVA_FILLER_IDS=diva2:833794,diva2:837011
